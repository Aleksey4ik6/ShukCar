/* ====== БАЗА (светлая тема) ====== */
* { font-family: "Segoe UI", Arial; }

QMainWindow, QWidget {
    background: #ffffff;
    color: #1b2a34;
    font-size: 13px;
}

/* ----- Карточка логина ----- */
#LoginCard {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid rgba(32,58,74,0.12);
}

/* ----- Поля ввода ----- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    padding: 10px 12px;
    border: 1px solid rgba(32,58,74,0.25);
    border-radius: 10px;
    background: #f9fafb;
    font-size: 14px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #203A4A;
    background: #ffffff;
}

/* ----- Кнопки ----- */
QPushButton {
    padding: 10px 14px;
    border-radius: 10px;
    background: #8B1E1E;
    border: 1px solid #8B1E1E;
    color: #ffffff;
    font-weight: 600;
    font-size: 14px;
}
QPushButton:hover { background: #a22a2a; }
QPushButton:pressed { background: #701616; }

/* вторичная кнопка */
QPushButton[accent="secondary"] {
    background: #ffffff;
    color: #1b2a34;
    border: 1px solid #d1d5db;
}
QPushButton[accent="secondary"]:hover { background: #f1f5f9; }

/* Мягкая подпись */
#MutedLabel { color: #64748b; font-size: 13px; }

/* ====== Верхний хедер ====== */
#Header {
    background: #f8fafc;
    border-bottom: 1px solid #e5e7eb;
}
#HeaderTitle {
    font-size: 16px;
    font-weight: 600;
    color: #0f172a;
}
#HeaderUser {
    color: #64748b;
    padding-left: 6px;
}
#TopSearch {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 8px 12px;
}
#TopSearch:focus { border-color: #203A4A; }

/* Кнопка "три точки" */
#KebabButton {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    color: #0f172a;
    font-size: 18px;
    padding: 0;
}
#KebabButton:hover { background: #eef2f7; }
#KebabButton:pressed { background: #e5e7eb; }

/* Полупрозрачный фон за панелью */
#Backdrop {
    background: rgba(15, 23, 42, 0.25); /* тёмный прозрачный */
}

/* Выезжающая панель */
#MorePanel {
    background: #ffffff;
    border-left: 1px solid #e5e7eb;
}
#MorePanel QPushButton {
    text-align: left;
}
#MorePanel QLabel#MoreTitle {
    font-size: 15px;
    font-weight: 600;
    color: #0f172a;
}

/* ====== Тулбар ====== */
QToolBar {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
    spacing: 6px;
    padding: 4px;
}
QToolButton {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 6px 10px;
    margin: 2px;
    color: #1f2937;
}
QToolButton:hover { background: #eef2f7; }
QToolButton:pressed { background: #e5e7eb; }

/* ====== Таблицы/Списки ====== */
QTableView, QTreeView, QListView, QListWidget {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    gridline-color: #e5e7eb;
    selection-background-color: #8B1E1E;
    selection-color: #ffffff;
}
QHeaderView::section {
    background: #f3f4f6;
    color: #475569;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    padding: 8px 6px;
    font-weight: 600;
}
QTableCornerButton::section {
    background: #f3f4f6;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    border-right: 1px solid #e5e7eb;
}

/* Группы/фреймы как карточки */
QGroupBox, .GroupBox, QFrame[frameShape="4"] {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 12px;
}

/* Статусбар */
QStatusBar {
    background: #f9fafb;
    color: #64748b;
    border-top: 1px solid #e5e7eb;
}

/* Скроллбары */
QScrollBar:vertical {
    background: #ffffff;
    width: 10px;
    margin: 4px 0 4px 0;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 24px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #ffffff;
    height: 10px;
    margin: 0 4px 0 4px;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 24px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover { background: #94a3b8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* Табы */
QTabBar::tab {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 6px 12px;
    color: #334155;
    margin-right: 6px;
}
QTabBar::tab:selected {
    background: #8B1E1E;
    color: #ffffff;
    border-color: #8B1E1E;
}

/* Сообщения */
QMessageBox { background: #ffffff; }

/* Диалоговые кнопки */
QDialogButtonBox QPushButton { min-width: 110px; }

/* Аккуратные чекбоксы по всему приложению */
QCheckBox { font-size: 14px; spacing: 10px; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border: 1px solid #d1d5db; border-radius: 5px; background: #ffffff;
}
QCheckBox::indicator:hover { border-color: #3b82f6; }
QCheckBox::indicator:checked {
    background: #3b82f6; border: 1px solid #3b82f6; image: url();
}
